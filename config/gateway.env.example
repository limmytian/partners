GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_STORE=postgres
GATEWAY_ARTIFACT_STORE=s3
GATEWAY_WORK_ROOT=/var/lib/partners/workspaces
GATEWAY_ARTIFACT_ROOT=/var/lib/partners/artifacts

GATEWAY_SERVICE_TOKEN=replace-with-secret
GATEWAY_SERVICE_TOKEN_REF=task-weaver-prod
GATEWAY_SERVICE_ACTOR=task-weaver
GATEWAY_SERVICE_SCOPES=*
GATEWAY_TENANT_IDS=
GATEWAY_PROJECT_IDS=
GATEWAY_SERVICE_TOKEN_EXPIRES_AT=

# Gateway Provider selection: 'local' | 'kubernetes' | 'cubesandbox'
GATEWAY_PROVIDER=local

# CubeSandbox MicroVM provider configuration
CUBESANDBOX_ENDPOINT=http://127.0.0.1:9090
CUBESANDBOX_API_KEY=replace-with-cubesandbox-api-key

# Kubernetes provider custom sandbox policy (all optional for the local provider)
PARTNERS_K8S_NAMESPACE=partners-sandbox
PARTNERS_K8S_SANDBOX_IMAGE=ghcr.io/limmytian/partners-sandbox@sha256:<digest>
PARTNERS_K8S_ALLOWED_REGISTRIES=ghcr.io
PARTNERS_K8S_ALLOWED_PROFILES=python-tools,node-tools
# JSON maps authorized profiles to immutable image and platform-owned refs.
PARTNERS_K8S_SANDBOX_PROFILES={}
PARTNERS_K8S_IMAGE_PULL_POLICY=IfNotPresent
PARTNERS_K8S_RUNTIME_CLASS=

POSTGRES_URL=postgres://partners:partners@postgres:5432/partners

S3_ENDPOINT=http://minio:9000
S3_BUCKET=partners-artifacts
S3_REGION=us-east-1
S3_PREFIX=gateway-artifacts
S3_ACCESS_KEY_ID=partners
S3_SECRET_ACCESS_KEY=replace-with-secret

RETENTION_MAX_AGE_HOURS=168
RETENTION_DRY_RUN=1
