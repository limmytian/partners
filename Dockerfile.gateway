ARG NODE_IMAGE=node:22-slim

FROM ${NODE_IMAGE} AS deps
WORKDIR /app
ENV NODE_ENV=production

COPY package.json ./
COPY package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM ${NODE_IMAGE} AS runner
ARG IMAGE_TAG=local
ARG VCS_REF=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="Partners Agent Execution Gateway" \
  org.opencontainers.image.description="Provider-agnostic hosted execution gateway for AI agent sandbox jobs" \
  org.opencontainers.image.version="${IMAGE_TAG}" \
  org.opencontainers.image.revision="${VCS_REF}" \
  org.opencontainers.image.created="${BUILD_DATE}" \
  org.opencontainers.image.source="https://github.com/limmytian/partners"

WORKDIR /app
ENV NODE_ENV=production \
  GATEWAY_HOST=0.0.0.0 \
  GATEWAY_PORT=8080 \
  GATEWAY_WORK_ROOT=/var/lib/partners/workspaces \
  GATEWAY_ARTIFACT_ROOT=/var/lib/partners/artifacts

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY package-lock.json ./
COPY src ./src
COPY scripts ./scripts

RUN mkdir -p /var/lib/partners/workspaces /var/lib/partners/artifacts \
  && chown -R node:node /var/lib/partners /app \
  && node -e "import('./src/index.js').then(() => console.log('gateway image import ok'))"

USER node

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "scripts/gateway-service.mjs"]
